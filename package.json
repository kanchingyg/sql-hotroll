{
  "name": "sql-hotroll",
  "version": "0.1.7",
  "description": "Find data loss in SQLite and Cloudflare D1 migrations before they run, plus expand/contract and session-quiescence schema evolution.",
  "license": "MIT",
  "author": "Augusto Cerrutti Satto <augustocerruttisatto@gmail.com>",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts",
    "./lenses": "./src/lenses.ts",
    "./ast-rewriter": "./src/ast-rewriter.ts",
    "./d1-adapter": "./src/d1-adapter.ts",
    "./postgres-adapter": "./src/postgres-adapter.ts",
    "./client-quiescence": "./src/client-quiescence.ts",
    "./attestation": "./src/attestation.ts",
    "./crypto-handshake": "./src/crypto-handshake.ts",
    "./hardware-auth": "./src/hardware-auth.ts",
    "./tui": "./src/tui.ts",
    "./cdn-range-gate": "./src/cdn-range-gate.ts",
    "./polyglot-sql": "./src/polyglot-sql.ts",
    "./lint": "./src/lint/index.ts",
    "./expand": "./src/expand/sqlite.ts"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "CREDITS.md",
    "CITATION.cff",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "check": "bun run lint && bun run typecheck && bun test",
    "build": "bun build src/bin.ts --target node --outfile dist/bin.js",
    "prepack": "bun run build",
    "verify:physics": "bun run testbeds/run-all.ts",
    "prepare": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanchingyg/sql-hotroll.git"
  },
  "keywords": [
    "cloudflare-d1",
    "sqlite",
    "postgresql",
    "schema-migration",
    "bidirectional-lenses",
    "session-quiescence",
    "zero-downtime",
    "slsa",
    "fido2",
    "tui",
    "drizzle",
    "migrations",
    "lint"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "^1.2.4",
    "typescript": "^7.0.2"
  },
  "bin": {
    "sql-hotroll": "dist/bin.js"
  },
  "engines": {
    "node": ">=22.13"
  }
}
