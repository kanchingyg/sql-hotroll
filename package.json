{
  "name": "sql-hotroll",
  "version": "0.2.0",
  "description": "Find data loss in SQLite and Cloudflare D1 migrations before they run, plus expand/contract and session-quiescence schema evolution.",
  "license": "MIT",
  "author": "Augusto Cerrutti Satto <augustocerruttisatto@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./lenses": {
      "types": "./dist/lenses.d.ts",
      "default": "./dist/lenses.js"
    },
    "./ast-rewriter": {
      "types": "./dist/ast-rewriter.d.ts",
      "default": "./dist/ast-rewriter.js"
    },
    "./d1-adapter": {
      "types": "./dist/d1-adapter.d.ts",
      "default": "./dist/d1-adapter.js"
    },
    "./postgres-adapter": {
      "types": "./dist/postgres-adapter.d.ts",
      "default": "./dist/postgres-adapter.js"
    },
    "./client-quiescence": {
      "types": "./dist/client-quiescence.d.ts",
      "default": "./dist/client-quiescence.js"
    },
    "./attestation": {
      "types": "./dist/attestation.d.ts",
      "default": "./dist/attestation.js"
    },
    "./crypto-handshake": {
      "types": "./dist/crypto-handshake.d.ts",
      "default": "./dist/crypto-handshake.js"
    },
    "./hardware-auth": {
      "types": "./dist/hardware-auth.d.ts",
      "default": "./dist/hardware-auth.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    },
    "./cdn-range-gate": {
      "types": "./dist/cdn-range-gate.d.ts",
      "default": "./dist/cdn-range-gate.js"
    },
    "./polyglot-sql": {
      "types": "./dist/polyglot-sql.d.ts",
      "default": "./dist/polyglot-sql.js"
    },
    "./lint": {
      "types": "./dist/lint/index.d.ts",
      "default": "./dist/lint/index.js"
    },
    "./expand": {
      "types": "./dist/expand/sqlite.d.ts",
      "default": "./dist/expand/sqlite.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CREDITS.md",
    "CITATION.cff",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "check": "bun run lint && bun run typecheck && bun test",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/bin.js',0o755)\"",
    "prepack": "npm run build",
    "verify:physics": "bun run testbeds/run-all.ts",
    "prepare": "npm run build",
    "check:jsr": "npx -y jsr publish --dry-run --allow-dirty"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanchingyg/sql-hotroll.git"
  },
  "keywords": [
    "cloudflare-d1",
    "sqlite",
    "postgresql",
    "schema-migration",
    "bidirectional-lenses",
    "session-quiescence",
    "zero-downtime",
    "slsa",
    "fido2",
    "tui",
    "drizzle",
    "migrations",
    "lint"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "^1.2.4",
    "typescript": "^7.0.2"
  },
  "bin": {
    "sql-hotroll": "dist/bin.js"
  },
  "engines": {
    "node": ">=22.13"
  }
}
